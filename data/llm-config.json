    "mode": "RULE_COACH"
  },
  "providers": ["OPENAI", "GEMINI", "CLAUDE", "LOCAL"],
  "implementedProviders": ["OPENAI"],
  "nonGoals": [
    "runtime mutation",
    "recommendation mutation",
    "question-db mutation",
    "direct OpenAI calls from Runtime/Coach"
  ]
}
