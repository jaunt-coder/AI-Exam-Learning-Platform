{
  "schemaVersion": "v1",
  "sprint": "Sprint-17D",
  "enabled": true,
  "provider": "OPENAI",
  "model": "gpt-5.5",
  "adapter": true,
  "connected": true,
  "api": {
    "baseUrl": "https://api.openai.com/v1",
    "chatPath": "/chat/completions",
    "timeoutMs": 30000
  },
  "cache": {
    "enabled": true,
    "storageKey": "learning.llm.cache.v1"
  },
  "fallback": {
    "enabled": true,
    "mode": "RULE_COACH"
  },
  "providers": ["OPENAI", "GEMINI", "CLAUDE", "LOCAL"],
  "implementedProviders": ["OPENAI", "GEMINI"],
  "geminiSolver": {
    "provider": "GEMINI",
    "model": "gemini-2.0-flash",
    "promptVersion": "17D.1",
    "problemFirst": true,
    "humanLevel": true,
    "professorLevel": true
  },
  "professorExplanation": {
    "provider": "GEMINI",
    "model": "gemini-2.0-flash",
    "promptVersion": "17D.1",
    "manualTriggerOnly": true,
    "qualityApproveThreshold": 90,
    "qualityPartialThreshold": 70,
    "evaluationSet": "data/professor-evaluation-test.json"
  },
  "geminiVision": {
    "provider": "GEMINI",
    "model": "gemini-2.0-flash",
    "promptVersion": "17B.1",
    "ocrThreshold": 70
  },
  "problemFirst": true,
  "nonGoals": [
    "runtime mutation",
    "recommendation mutation",
    "mastery mutation",
    "question-db mutation",
    "pattern-db mutation",
    "statistics-db mutation",
    "direct Gemini calls from Runtime/Learning Engine",
    "auto bulk professor cache generation"
  ]
}
