{
  "schemaVersion": "v1",
  "sprint": "Sprint-17A",
  "enabled": true,
  "provider": "GEMINI",
  "model": "gemini-2.0-flash",
  "adapter": true,
  "connected": true,
  "api": {
    "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
    "chatPath": "/models/{model}:generateContent",
    "timeoutMs": 45000
  },
  "cache": {
    "enabled": true,
    "storageKey": "learning.gemini-cache.v1"
  },
  "fallback": {
    "enabled": true,
    "mode": "LOCAL_PROBLEM_FIRST"
  },
  "providers": ["OPENAI", "GEMINI", "CLAUDE", "LOCAL"],
  "implementedProviders": ["OPENAI", "GEMINI"],
  "problemFirst": true,
  "nonGoals": [
    "runtime mutation",
    "recommendation mutation",
    "mastery mutation",
    "question-db mutation",
    "pattern-db mutation",
    "statistics-db mutation",
    "direct Gemini calls from Runtime/Learning Engine"
  ]
}
